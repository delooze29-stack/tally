rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Day number the game uses (day 1 = 23 Oct 2026). Allow one day either side for time zones.
    function dayNow() {
      return int(math.floor((request.time.toMillis() - 1792713600000) / 86400000)) + 1;
    }
    function pointsFor(won, guesses) {
      return won ? [0, 10, 8, 6, 4, 3, 2, 1][guesses] : 0;
    }
    function scorePath(day, uid) {
      return /databases/$(database)/documents/scores/$(string(day) + '_' + uid);
    }

    match /players/{uid} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'played', 'wins', 'last'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 16
        && request.resource.data.total == 0
        && request.resource.data.played == 0
        && request.resource.data.wins == 0
        && request.resource.data.last == 0;

      // Totals can only move by exactly the score being saved in the same write.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'total', 'played', 'wins', 'last'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.last is int
        && !exists(scorePath(request.resource.data.last, uid))
        && existsAfter(scorePath(request.resource.data.last, uid))
        && request.resource.data.total == resource.data.total
             + getAfter(scorePath(request.resource.data.last, uid)).data.points
        && request.resource.data.played == resource.data.played + 1
        && request.resource.data.wins == resource.data.wins
             + (getAfter(scorePath(request.resource.data.last, uid)).data.won ? 1 : 0);

      allow delete: if false;
    }

    // Nicknames: one document per nickname, so each can only be claimed once.
    match /names/{nameId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && nameId.size() >= 2 && nameId.size() <= 16;
      allow update, delete: if false;
    }

    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'guesses', 'won', 'points', 'secs', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is int
        && request.resource.data.day >= dayNow() - 1
        && request.resource.data.day <= dayNow() + 1
        && scoreId == string(request.resource.data.day) + '_' + request.auth.uid
        && request.resource.data.guesses is int
        && request.resource.data.guesses >= 1 && request.resource.data.guesses <= 7
        && request.resource.data.won is bool
        && (request.resource.data.won || request.resource.data.guesses == 7)
        && request.resource.data.secs is int
        && request.resource.data.secs >= 0 && request.resource.data.secs <= 86400
        && request.resource.data.points == pointsFor(request.resource.data.won, request.resource.data.guesses)
        && request.resource.data.ts == request.time
        && request.resource.data.name == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.last == request.resource.data.day;

      allow update, delete: if false;
    }

    // ---------- Challenges ----------
    function chPath(id) { return /databases/$(database)/documents/challenges/$(id); }
    function attPath(id, uid) { return /databases/$(database)/documents/attempts/$(id + '_' + uid); }
    function playerPath(uid) { return /databases/$(database)/documents/players/$(uid); }
    function limitPath(uid, day) { return /databases/$(database)/documents/limits/$(uid + '_' + string(day)); }

    // How many challenges a player has taken on each day (max 5).
    match /limits/{lid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'day', 'n'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is int
        && request.resource.data.day >= dayNow() - 1
        && request.resource.data.day <= dayNow() + 1
        && lid == request.auth.uid + '_' + string(request.resource.data.day)
        && request.resource.data.n == 1;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.n <= 5;
      allow delete: if false;
    }

    match /challenges/{cid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['setter', 'setterName', 'c', 'cs', 'target', 'stake', 'created', 'expires', 'open', 'tries', 'cracks'])
        && request.resource.data.setter == request.auth.uid
        && request.resource.data.setterName == get(playerPath(request.auth.uid)).data.name
        && request.resource.data.c is string && request.resource.data.c.size() == 7
        && request.resource.data.cs is int
        && request.resource.data.cs >= 0 && request.resource.data.cs < 1000000000
        && request.resource.data.target is int
        && request.resource.data.target >= 3 && request.resource.data.target <= 7
        && request.resource.data.stake is int
        && request.resource.data.stake >= 1 && request.resource.data.stake <= 10
        && request.resource.data.created == request.time
        && request.resource.data.expires is int
        && request.resource.data.expires > request.time.toMillis()
        && request.resource.data.expires <= request.time.toMillis() + 8 * 86400000
        && request.resource.data.open == true
        && request.resource.data.tries == 0
        && request.resource.data.cracks == 0;

      allow update: if request.auth != null && (
        // The setter closes their own challenge.
        (resource.data.setter == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open'])
          && request.resource.data.open == false)
        ||
        // A player accepts: tries goes up by one, in the same write as their attempt.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tries'])
          && request.resource.data.tries == resource.data.tries + 1
          && !exists(attPath(cid, request.auth.uid))
          && existsAfter(attPath(cid, request.auth.uid)))
        ||
        // A player cracks it: cracks goes up by one, in the same write as their winning attempt.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cracks'])
          && request.resource.data.cracks == resource.data.cracks + 1
          && get(attPath(cid, request.auth.uid)).data.status == 'playing'
          && getAfter(attPath(cid, request.auth.uid)).data.won == true)
      );

      allow delete: if false;
    }

    match /attempts/{aid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ch', 'uid', 'name', 'setter', 'sname', 'stake', 'target', 'day', 'g', 'status', 'won', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && aid == request.resource.data.ch + '_' + request.auth.uid
        && get(chPath(request.resource.data.ch)).data.open == true
        && get(chPath(request.resource.data.ch)).data.expires > request.time.toMillis()
        && get(chPath(request.resource.data.ch)).data.setter != request.auth.uid
        && request.resource.data.setter == get(chPath(request.resource.data.ch)).data.setter
        && request.resource.data.sname == get(chPath(request.resource.data.ch)).data.setterName
        && request.resource.data.stake == get(chPath(request.resource.data.ch)).data.stake
        && request.resource.data.target == get(chPath(request.resource.data.ch)).data.target
        && request.resource.data.name == get(playerPath(request.auth.uid)).data.name
        && request.resource.data.day is int
        && getAfter(limitPath(request.auth.uid, request.resource.data.day)).data.n
             == (exists(limitPath(request.auth.uid, request.resource.data.day))
                 ? get(limitPath(request.auth.uid, request.resource.data.day)).data.n : 0) + 1
        && request.resource.data.g == []
        && request.resource.data.status == 'playing'
        && request.resource.data.won == false
        && request.resource.data.ts == request.time
        && getAfter(chPath(request.resource.data.ch)).data.tries == get(chPath(request.resource.data.ch)).data.tries + 1;

      // Guesses are added while playing. Once it's done, it's locked.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'playing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g', 'status', 'won', 'secs', 'ts'])
        && request.resource.data.g is list
        && request.resource.data.g.size() >= resource.data.g.size()
        && request.resource.data.g.size() <= resource.data.target
        && request.resource.data.status in ['playing', 'done']
        && (!('secs' in request.resource.data) || (request.resource.data.secs is int && request.resource.data.secs >= 0 && request.resource.data.secs <= 86400))
        && request.resource.data.ts == request.time
        && (request.resource.data.status == 'playing'
            || request.resource.data.won == true
            || request.resource.data.g.size() == resource.data.target)
        && (request.resource.data.won == false
            || (request.resource.data.status == 'done'
                && getAfter(chPath(resource.data.ch)).data.cracks == get(chPath(resource.data.ch)).data.cracks + 1));

      allow delete: if false;
    }
  }
}
